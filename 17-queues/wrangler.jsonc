{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "python-queues",
	"main": "src/entry.py",
	"compatibility_date": "2025-11-02",
	"compatibility_flags": [
		"python_workers"
	],
	"queues": {
		"producers": [
			{
				"binding": "MY_QUEUE",
				"queue": "my-python-queue"
			}
		],
		"consumers": [
			{
				"queue": "my-python-queue",
				"max_batch_size": 10,
				"max_batch_timeout": 5
			}
		]
	},
	"observability": {
		"enabled": true
	}
}
